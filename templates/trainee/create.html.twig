<h1>New Trainee : Symfony Form</h1>

{# {{ form(traineeForm) }} #}




{{ form_start(traineeForm) }}
    {{ form_widget(traineeForm.id) }}

    <fieldset>
        <legend>Name: </legend>
        {{ form_widget(traineeForm.name) }}

        {% for error in traineeForm.name.vars.errors %}
            <div style="font-size: 12px; color: #f00;">
                {{ error.message }}
            </div>
        {% endfor %}

    </fieldset>
    <fieldset>
        <legend>Email: </legend>
        {{ form_widget(traineeForm.email) }}

        {% for error in traineeForm.email.vars.errors %}
            <div style="font-size: 12px; color: #f00;">
                {{ error.message }}
            </div>
        {% endfor %}
    </fieldset>
    <fieldset>
        <legend>Action: </legend>
        {{ form_widget(traineeForm.create) }}
    </fieldset>

{{ form_end(traineeForm) }}