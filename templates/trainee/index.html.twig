<h1>Welcome to the about us page.</h1>


<a href="{{ path('app_trainee_new') }}">Add New Trainee</a>

<br /> <br />

<table border="1" cellpadding="10" cellspacing="0">
    <tr>
        <th>S. No.</th>
        <th>Trainee</th>
        <th>Email</th>
        <th>Created At</th>
        <th>Action</th>
    </tr>

    {% set index = 0 %}
    {% if trainees is defined %}
        {% for trainee in trainees %}
            <tr>
                <td>{{ index + 1 }}</td>
                <td>{{ trainee.name }}</td>
                <td>{{ trainee.email }}</td>
                <td>{{ trainee.createdAt | date('Y-m-d') }}</td>
                <td>
                    <a href="{{ path('app_detail', { 'num' : index + 1 }) }}">View Detail</a>
                </td>
            </tr>

            {% set index = index + 1 %}
        {% endfor %}
    {% endif %}

</table>


<a href="{{ path('dashboard_action') }}">Jump to homepage</a>